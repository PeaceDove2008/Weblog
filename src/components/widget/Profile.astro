---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const className: string = Astro.props.class ?? "";
---
<div class:list={[className, "card-base tinted p-5 relative !overflow-visible"]} style="--card-tint: oklch(0.94 0.08 90)">
    <div class="sticker absolute -top-3 -right-2 rotate-6 text-sm px-3 h-8 z-10">Hi!</div>
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-4
       max-w-[13rem] lg:max-w-none overflow-hidden rounded-xl active:scale-95
       border-[3px] border-[var(--brutal-border)] shadow-[3px_3px_0_0_var(--brutal-shadow)]">
        <div class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center">
            <Icon name="fa6-regular:address-card"
                  class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl">
            </Icon>
        </div>
        <ImageWrapper src={config.avatar || ""} alt="Profile Image of the Author" class="mx-auto lg:w-full h-full lg:mt-0 "></ImageWrapper>
    </a>
    <div class="px-2">
        <div class="sticker-text font-bold text-2xl lg:text-2xl text-center mb-1.5 transition">{config.name}</div>
        <div class="h-1.5 w-9 bg-[var(--sticker-yellow)] mx-auto -rotate-3 rounded-sm mb-2 transition"></div>
        <div class="text-center text-neutral-500 dark:text-neutral-400 mb-3 transition text-base leading-relaxed">{config.bio}</div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {config.links.map(item =>
                item.url ? (
                    <a rel="me" aria-label={item.name} href={item.url} target="_blank"
                       class="btn-regular rounded-lg h-10 w-10 active:scale-90
                       hover:-translate-y-0.5 hover:-rotate-3 hover:shadow-[3px_3px_0_0_var(--brutal-shadow)]">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                    </a>
                ) : (
                    <span aria-label={item.name} class="btn-regular rounded-lg h-10 w-10 active:scale-90
                           hover:-translate-y-0.5 hover:-rotate-3 hover:shadow-[3px_3px_0_0_var(--brutal-shadow)]
                           group relative">
                        <Icon name={item.icon} class="text-[1.5rem]"></Icon>
                        <span class="absolute bottom-12 left-1/2 -translate-x-1/2 z-30 hidden group-hover:block
                                     bg-white dark:bg-[oklch(0.24_0.04_var(--hue))] rounded-lg
                                     border-[2.5px] border-[var(--brutal-border)]
                                     shadow-[3px_3px_0_0_var(--brutal-shadow)] p-2 w-36">
                            <img src={item.name === "QQ" ? "/qrcode/qq.jpg" : "/qrcode/wechat.png"}
                                 class="w-full rounded-md" alt={`${item.name} 二维码`} />
                            <div class="text-center text-xs font-bold mt-1.5 text-black dark:text-white">
                                {item.name} · 扫码联系
                            </div>
                        </span>
                    </span>
                )
            )}
        </div>
    </div>
</div>