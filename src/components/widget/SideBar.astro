---
import type { MarkdownHeading } from "astro";
import AiShowcase from "./AiShowcase.svelte";
import Profile from "./Profile.astro";
import Stats from "./Stats.astro";
import Tag from "./Tags.astro";

const className: string = Astro.props.class ?? "";
const hideMobile: boolean = Astro.props.hideMobile === true;
---

<div id="sidebar" class:list={[className, "w-full", { "hidden lg:block": hideMobile }]}>
    <div class="flex flex-row items-stretch gap-2 mb-3 lg:hidden">
        <Profile class="flex-1 min-w-0"></Profile>
        <Stats class="flex-1 min-w-0"></Stats>
        <AiShowcase class="flex-1 min-w-0" client:load
                    images={["/ai-art/pic1.png", "/ai-art/pic2.png", "/ai-art/pic3.png", "/ai-art/pic4.png", "/ai-art/pic5.png", "/ai-art/pic6.png"]}
                    captions={[
                        "欢迎来到毛茸茸小窝 🐾",
                        "这里是用 AI 画的小动物们 ✨",
                        "喜欢的话常来逛逛吧～",
                    ]}
        ></AiShowcase>
    </div>

    <div class="hidden lg:flex flex-col w-full gap-6 mb-6">
        <Profile></Profile>
    </div>
    <div id="sidebar-sticky" class="hidden lg:flex transition-all duration-700 flex-col w-full gap-6 top-6 sticky top-6">
        <Stats class="onload-animation" style="animation-delay: 150ms"></Stats>
        <Tag class="onload-animation" style="animation-delay: 200ms"></Tag>
        <AiShowcase client:load
                    images={["/ai-art/pic1.png", "/ai-art/pic2.png", "/ai-art/pic3.png", "/ai-art/pic4.png", "/ai-art/pic5.png", "/ai-art/pic6.png"]}
                    captions={[
                        "欢迎来到毛茸茸小窝 🐾",
                        "这里是用 AI 画的小动物们 ✨",
                        "喜欢的话常来逛逛吧～",
                    ]}
        ></AiShowcase>
    </div>
</div>
